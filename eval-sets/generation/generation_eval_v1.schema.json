{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Generation Evaluation v1",
  "type": "object",
  "required": ["evaluation_version", "dataset_status", "source_retrieval_eval_sha256", "items"],
  "properties": {
    "evaluation_version": {"const": "generation-eval-v1"},
    "dataset_status": {"enum": ["draft", "verified"]},
    "source_retrieval_eval_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "items": {"type": "array", "minItems": 31, "maxItems": 31, "items": {"$ref": "#/$defs/item"}}
  },
  "$defs": {
    "item": {
      "type": "object",
      "required": ["query_id", "query", "split", "answerability", "required_points", "reference_answer", "annotation_notes", "annotation_confidence", "annotation_status"],
      "properties": {
        "query_id": {"type": "string", "minLength": 1},
        "query": {"type": "string", "minLength": 1},
        "split": {"const": "eval"},
        "answerability": {"enum": ["answerable", "insufficient_evidence"]},
        "required_points": {"type": "array", "items": {"$ref": "#/$defs/point"}},
        "reference_answer": {"type": "string", "minLength": 1},
        "annotation_notes": {"type": "string", "minLength": 1},
        "annotation_confidence": {"enum": ["high", "medium", "low"]},
        "annotation_status": {"enum": ["draft", "verified"]}
      }
    },
    "point": {
      "type": "object",
      "required": ["point_id", "description", "importance", "supporting_chunk_ids"],
      "properties": {
        "point_id": {"type": "string", "minLength": 1},
        "description": {"type": "string", "minLength": 1},
        "importance": {"enum": ["required", "important"]},
        "supporting_chunk_ids": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}}
      }
    }
  }
}
