{
  "schema": "phase5c3-controller-status-decision-spec-v0",
  "design_only": true,
  "runtime_implementation_created": false,
  "scope": "Finite nonempty bounded material legal scope; predicates describe runtime evidence/selected final answer only, never benchmark gold. Out-of-scope/non-material tasks require separate review, not vacuous success.",
  "status_source": "runtime_estimate; NEVER benchmark-certified",
  "predicates": {
    "execution_completed": {
      "domain": [
        false,
        true
      ],
      "meaning": "Pipeline reached normal finalization without unrecovered execution/transport failure. Budget-limited normal termination may be true; a recovered failed attempt alone does not set false."
    },
    "final_answer_exists": {
      "domain": [
        false,
        true
      ],
      "meaning": "A nonempty selected final answer version exists, including a nonempty calibrated insufficiency/disclosure response. Empty/whitespace output is false; a retained intermediate draft alone is false."
    },
    "final_check_fresh": {
      "domain": [
        false,
        true,
        null
      ],
      "meaning": "All required final checks were reached, parsed and bound to exact selected final answer/evidence/scope hashes; true does not imply their verdict passed. false means known missing/stale/unparsed check; null means freshness provenance unavailable."
    },
    "citation_valid": {
      "domain": [
        false,
        true,
        null
      ],
      "meaning": "Current-final required citation checks: true if all pass or a recorded current assessment establishes no citation obligation; false if any current required syntax/semantic check fails; null if no conclusive current result. Old-version failures are secondary history, not current false."
    },
    "supported_answerable_content_exists": {
      "domain": [
        false,
        true,
        null
      ],
      "meaning": "At least one material portion of bounded intent has adequate applicable support in the final controller-visible evidence, whether or not the answer states it. Includes a defensibly qualified supported subportion. Never corpus gold."
    },
    "supported_answerable_content_omitted": {
      "domain": [
        false,
        true,
        null
      ],
      "meaning": "At least one such supported material response portion is absent or materially misstated in selected final answer. Disclosure cannot repair a supported omission."
    },
    "unresolved_material_aspects_exist": {
      "domain": [
        false,
        true,
        null
      ],
      "meaning": "At least one explicit/admitted material response obligation remains unresolved: supported omission or evidence/applicability-limited portion. Unsupported extra wording is tracked separately; unadmitted inferred candidates do not create obligations."
    },
    "unresolved_material_aspects_disclosed": {
      "domain": [
        false,
        true,
        null
      ],
      "meaning": "Every unresolved material obligation is specifically and accurately disclosed in selected final answer. When none exist use true (vacuous obligation coverage, not a metric score). null means unassessed; false means at least one missing/inaccurate disclosure."
    },
    "unsupported_material_claim_exists": {
      "domain": [
        false,
        true,
        null
      ],
      "meaning": "At least one asserted material legal claim lacks adequate support or defensible applicability in exact final evidence. Independent of citation syntax and omitted supported content."
    },
    "evidence_sufficient_for_full_scope": {
      "domain": [
        false,
        true,
        null
      ],
      "meaning": "Every material obligation in the finite nonempty bounded legal scope has sufficient applicable final-evidence support. Conditional questions can be fully supported with conditions preserved; missing conditions needed for concrete conclusions prevent full sufficiency."
    },
    "evidence_sufficient_for_partial_scope": {
      "domain": [
        false,
        true,
        null
      ],
      "meaning": "INCLUSIVE existential: evidence supports at least one material portion, including when it supports full scope. Equivalent to supported_answerable_content_exists; not the exclusive partially_answerable gold enum."
    },
    "runtime_budget_exhausted": {
      "domain": [
        false,
        true
      ],
      "meaning": "Configured runtime resource ceiling reached. Orthogonal to status; cannot upgrade an incomplete/unverified response to success or infer evidence insufficiency."
    }
  },
  "condition_language": {
    "eq": "Exact type-sensitive equality [predicate_name, literal]; JSON null is a distinct unknown, never false.",
    "all": "Conjunction of child conditions.",
    "any": "Disjunction of child conditions.",
    "omitted_predicate_in_condition": "Wildcard over its declared domain; never implicit false."
  },
  "evaluation_contract": [
    "Reject missing/extra keys or wrong types as INVALID_STATE with null final_status. Python/JSON numeric 0/1 are not booleans.",
    "Collect ALL matching invalid-state rules; if any match, disposition INVALID_STATE and final_status null.",
    "Otherwise collect all review rules; if any match, disposition REQUIRES_REVIEW and final_status null.",
    "Otherwise exactly one runtime row MUST match, independently of row order. Emit VALID_STATE and that final_status. A zero/multiple match is a specification failure requiring review; it cannot receive success.",
    "Retain input snapshot, matched rule IDs, exact evidence/answer/check hashes and every known secondary flag. Do not silently repair contradictions or infer missing predicates."
  ],
  "invalid_state_rules": [
    {
      "id": "I01",
      "when": {
        "all": [
          {
            "eq": [
              "final_answer_exists",
              false
            ]
          },
          {
            "eq": [
              "final_check_fresh",
              true
            ]
          }
        ]
      },
      "reason": "No final answer exists to bind a fresh final check."
    },
    {
      "id": "I02",
      "when": {
        "all": [
          {
            "eq": [
              "final_answer_exists",
              false
            ]
          },
          {
            "any": [
              {
                "eq": [
                  "citation_valid",
                  true
                ]
              },
              {
                "eq": [
                  "citation_valid",
                  false
                ]
              }
            ]
          }
        ]
      },
      "reason": "A current-final citation verdict requires final answer bytes."
    },
    {
      "id": "I03",
      "when": {
        "all": [
          {
            "eq": [
              "final_answer_exists",
              false
            ]
          },
          {
            "eq": [
              "unsupported_material_claim_exists",
              true
            ]
          }
        ]
      },
      "reason": "No final answer can contain an asserted material claim."
    },
    {
      "id": "I04",
      "when": {
        "all": [
          {
            "eq": [
              "final_answer_exists",
              false
            ]
          },
          {
            "eq": [
              "unresolved_material_aspects_exist",
              true
            ]
          },
          {
            "eq": [
              "unresolved_material_aspects_disclosed",
              true
            ]
          }
        ]
      },
      "reason": "An absent final answer cannot disclose actual unresolved obligations."
    },
    {
      "id": "I05",
      "when": {
        "any": [
          {
            "all": [
              {
                "eq": [
                  "supported_answerable_content_exists",
                  true
                ]
              },
              {
                "eq": [
                  "evidence_sufficient_for_partial_scope",
                  false
                ]
              }
            ]
          },
          {
            "all": [
              {
                "eq": [
                  "supported_answerable_content_exists",
                  false
                ]
              },
              {
                "eq": [
                  "evidence_sufficient_for_partial_scope",
                  true
                ]
              }
            ]
          }
        ]
      },
      "reason": "The two inclusive support-existence predicates disagree."
    },
    {
      "id": "I06",
      "when": {
        "all": [
          {
            "eq": [
              "evidence_sufficient_for_full_scope",
              true
            ]
          },
          {
            "eq": [
              "evidence_sufficient_for_partial_scope",
              false
            ]
          }
        ]
      },
      "reason": "Full support of a nonempty material scope implies some support."
    },
    {
      "id": "I07",
      "when": {
        "all": [
          {
            "eq": [
              "evidence_sufficient_for_full_scope",
              true
            ]
          },
          {
            "eq": [
              "supported_answerable_content_exists",
              false
            ]
          }
        ]
      },
      "reason": "Full support implies supported content exists."
    },
    {
      "id": "I08",
      "when": {
        "all": [
          {
            "eq": [
              "supported_answerable_content_omitted",
              true
            ]
          },
          {
            "eq": [
              "supported_answerable_content_exists",
              false
            ]
          }
        ]
      },
      "reason": "Supported omission requires supported content."
    },
    {
      "id": "I09",
      "when": {
        "all": [
          {
            "eq": [
              "supported_answerable_content_omitted",
              true
            ]
          },
          {
            "eq": [
              "unresolved_material_aspects_exist",
              false
            ]
          }
        ]
      },
      "reason": "Supported omitted response content remains unresolved."
    },
    {
      "id": "I10",
      "when": {
        "all": [
          {
            "eq": [
              "evidence_sufficient_for_full_scope",
              false
            ]
          },
          {
            "eq": [
              "unresolved_material_aspects_exist",
              false
            ]
          }
        ]
      },
      "reason": "An evidence/applicability-limited material scope necessarily retains unresolved portions."
    },
    {
      "id": "I11",
      "when": {
        "all": [
          {
            "eq": [
              "evidence_sufficient_for_full_scope",
              true
            ]
          },
          {
            "eq": [
              "supported_answerable_content_omitted",
              false
            ]
          },
          {
            "eq": [
              "unresolved_material_aspects_exist",
              true
            ]
          }
        ]
      },
      "reason": "With full support and no supported omission, no response obligation remains unresolved under these definitions."
    },
    {
      "id": "I12",
      "when": {
        "all": [
          {
            "eq": [
              "unresolved_material_aspects_exist",
              false
            ]
          },
          {
            "eq": [
              "unresolved_material_aspects_disclosed",
              false
            ]
          }
        ]
      },
      "reason": "With no unresolved obligation disclosure completeness is canonically true, never false."
    }
  ],
